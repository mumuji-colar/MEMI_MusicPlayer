<?xml version="1.0" encoding="utf-8"?>
<!--
  系统启动图（Android 12+）用的占位图标：全透明。

  冷启动时系统会先画一张只有图标的启动图，然后才轮到 Compose 的品牌页；
  两张图连着看就是「单 logo 页 → 带应用名的一页」，很割裂。
  这里把系统那张图的图标抹掉，只留底色（深浅色各自与品牌页同色），
  视觉上就是：一片同色 → 图标和应用名一起出现，中间不再闪一个单独的头像。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
